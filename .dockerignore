.git
.gitignore
.dockerignore

# Build and test artifacts.
dist
poomsae
poomsae.exe
coverage.out
*.test
*.out
/result

# Dependencies and web bundles are rebuilt inside the image.
**/node_modules
/web/dist

# Local daemon state and secrets. Docker federation smoke builds should never
# capture a developer's live data, credentials, or SQLite files in context.
/.poomsae/
/.poomsae-*/
**/credentials.toml
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Repo-local work/agent/editor state.
/.worktrees/
/.superpowers/
/.codex/
/.superset/
/.claude/settings.local.json
.vscode/
.idea/
*.swp
*~
.DS_Store
.poomsae.local.toml
