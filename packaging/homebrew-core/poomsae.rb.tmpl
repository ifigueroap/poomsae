class Poomsae < Formula
  desc "Git-native issue tracking for agentic development"
  homepage "https://github.com/ifigueroap/poomsae"
  url "https://github.com/ifigueroap/poomsae/releases/download/v{{ .Version }}/poomsae_{{ .Version }}_source.tar.gz"
  sha256 "{{ .SHA256 }}"
  license "MIT"

  livecheck do
    url :stable
    strategy :github_latest
  end

  depends_on "go" => :build

  def install
    ENV["CGO_ENABLED"] = "0"
    ldflags = %W[
      -s -w
      -X github.com/ifigueroap/poomsae/internal/version.Version=v#{version}
      -X github.com/ifigueroap/poomsae/internal/version.Distribution=homebrew
      -X github.com/ifigueroap/poomsae/internal/version.BuildDate={{ .BuildDate }}
    ]
    system "go", "build", *std_go_args(ldflags: ldflags), "-mod=vendor", "-trimpath", "-buildvcs=false", "./cmd/poomsae"
  end

  test do
    info = shell_output("#{bin}/poomsae version --json")
    assert_match %Q("version":"v#{version}"), info
    assert_match '"distribution":"homebrew"', info
    system bin/"poomsae", "_web-assets-check"
    assert_match "brew upgrade poomsae", shell_output("#{bin}/poomsae update --yes 2>&1", 2)
  end
end
